# Z-Code Backend Environment Variables
# Copy this file to .env and fill in your values

# JWT Secret — change this to a long random string in production
SECRET_KEY=zcode-super-secret-key-change-in-production-2024

# JWT algorithm
ALGORITHM=HS256

# Token expiry in minutes (e.g. 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# NVIDIA AI API (Nemotron 3 Ultra)
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Gemini AI API Key (optional fallback)
GEMINI_API_KEY=

# SQLite database file path (relative to backend/)
DATABASE_URL=sqlite+aiosqlite:///./zcode.db

# CORS origins — comma-separated list of allowed frontend URLs
CORS_ORIGINS=http://localhost,http://127.0.0.1,null,file://
